include LICENSE NOTICE.md CHANGELOG.md CONTRIBUTING.md
include *.zh-CN.md
include docs/locales.json
recursive-include docs *.md
recursive-include docs/assets *.svg *.png *.jpg *.webm *.json
recursive-include docs/demo *.html *.js *.css *.py
recursive-include benchmarks *.py *.md *.json *.jsonl *.xml
recursive-include examples *.py *.json *.md
recursive-include scripts *.py
recursive-include tests *.py
include requirements-macos-py313.lock
prune benchmarks/__pycache__
global-exclude *.pyc .DS_Store
