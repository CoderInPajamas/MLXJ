include LICENSE NOTICE.md CHANGELOG.md CONTRIBUTING.md
recursive-include docs *.md
recursive-include docs/assets *.svg *.png *.webm *.json
recursive-include benchmarks *.py *.json *.jsonl
recursive-include examples *.py *.json *.md
recursive-include scripts *.py
recursive-include tests *.py
include requirements-macos-py313.lock
prune benchmarks/__pycache__
global-exclude *.pyc .DS_Store
